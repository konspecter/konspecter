# Konspecter server settings. Copy to .env (or point KONSPECTER_ENV_FILE at
# another file); variables set in the real environment win over this file.

# PostgreSQL connection URL (required).
KONSPECTER_DATABASE_URL=postgres://konspecter:konspecter@localhost:5432/konspecter?sslmode=disable

# Listen address.
KONSPECTER_ADDR=:8080

# Comma-separated browser origins allowed to call the API (the web app, the
# desktop and mobile shells). The account site is same-origin and needs none.
KONSPECTER_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,tauri://localhost,http://tauri.localhost,https://localhost

# --- Accounts on the site ---------------------------------------------------

# The site's public origin (the site and API share it behind the proxy).
# Sign-in is off without it. Emails link here, the session cookie is Secure
# on https, and sign-in requests must come from this origin.
# Development: the site's dev server.
KONSPECTER_PUBLIC_URL=http://localhost:5174

# "open" (anyone may create an account) or "closed" (only existing ones).
KONSPECTER_REGISTRATION=open

# Lifetimes (Go durations: 30m, 720h).
KONSPECTER_SESSION_TTL=720h
KONSPECTER_EMAIL_CODE_TTL=10m
KONSPECTER_PASSWORD_RESET_TTL=30m
# How long an app's request to connect (Sign in with browser) waits for approval.
KONSPECTER_DEVICE_CODE_TTL=10m

# Email: "smtp" sends through the server below; "log" writes messages to the
# log instead (development only: the log then holds sign-in codes).
KONSPECTER_MAIL_TRANSPORT=log
KONSPECTER_SMTP_HOST=
KONSPECTER_SMTP_PORT=587
KONSPECTER_SMTP_USERNAME=
KONSPECTER_SMTP_PASSWORD=
KONSPECTER_SMTP_FROM=Konspecter <noreply@example.com>
# starttls (port 587), tls (port 465) or none (a local relay only).
KONSPECTER_SMTP_TLS=starttls

# --- Sign-in with other services ----------------------------------------------

# Register an app with each provider and give it this callback URL:
#   <KONSPECTER_PUBLIC_URL>/api/auth/<provider>/callback
# (google, linkedin, x, yandex or vk). A provider is on only when both its
# client id and secret are set.
#   Google:   console.cloud.google.com, an OAuth client of type "Web application".
#   LinkedIn: the "Sign In with LinkedIn using OpenID Connect" product.
#   X:        OAuth 2.0, a "Web App" (confidential client).
#   Yandex:   oauth.yandex.ru, with the "access to email address" permission.
#   VK:       id.vk.com, a web app with the "email" access.
KONSPECTER_OAUTH_GOOGLE_CLIENT_ID=
KONSPECTER_OAUTH_GOOGLE_CLIENT_SECRET=
KONSPECTER_OAUTH_LINKEDIN_CLIENT_ID=
KONSPECTER_OAUTH_LINKEDIN_CLIENT_SECRET=
KONSPECTER_OAUTH_X_CLIENT_ID=
KONSPECTER_OAUTH_X_CLIENT_SECRET=
KONSPECTER_OAUTH_YANDEX_CLIENT_ID=
KONSPECTER_OAUTH_YANDEX_CLIENT_SECRET=
KONSPECTER_OAUTH_VK_CLIENT_ID=
KONSPECTER_OAUTH_VK_CLIENT_SECRET=

# The providers the site shows, by the visitor's language (comma-separated,
# in order). Listed providers that are not set up above are left out.
KONSPECTER_LOGIN_PROVIDERS_EN=google,linkedin,x
KONSPECTER_LOGIN_PROVIDERS_RU=yandex,vk

# Proxies whose X-Forwarded-For names the real client (the reverse proxy and
# the site's server): comma-separated IPs or CIDR prefixes.
KONSPECTER_TRUSTED_PROXIES=127.0.0.1,::1

# Abuse limits: failed sign-ins per 15 minutes, emails and requests to
# connect an app per hour.
KONSPECTER_RATE_LOGIN_PER_IP=20
KONSPECTER_RATE_LOGIN_PER_EMAIL=10
KONSPECTER_RATE_EMAIL_PER_ADDRESS=5
KONSPECTER_RATE_EMAIL_PER_IP=20
KONSPECTER_RATE_DEVICE_PER_IP=20

# --- Paid sync -----------------------------------------------------------------

# Empty: sync is free. Set, a separate service decides whether an account may
# sync. Paid sync needs KONSPECTER_PUBLIC_URL and email.
# The token is shared with the service (at least 32 characters): openssl rand -hex 32
KONSPECTER_BILLING_URL=
KONSPECTER_BILLING_TOKEN=
