# Konspecter server settings. Copy to .env (or point KONSPECTER_ENV_FILE at
# another file); variables set in the real environment win over this file.

# PostgreSQL connection URL (required).
KONSPECTER_DATABASE_URL=postgres://konspecter:konspecter@localhost:5432/konspecter?sslmode=disable

# Listen address.
KONSPECTER_ADDR=:8080

# Comma-separated browser origins allowed to call the API (the web app, the
# desktop and mobile shells). The account site is same-origin and needs none.
KONSPECTER_ALLOWED_ORIGINS=http://localhost:5173,tauri://localhost,http://tauri.localhost,https://localhost

# --- Accounts on the site ---------------------------------------------------

# The site's public origin (the site and API share it behind the proxy).
# Sign-in is off without it. Emails link here, the session cookie is Secure
# on https, and sign-in requests must come from this origin.
# Development: the site's dev server.
KONSPECTER_PUBLIC_URL=http://localhost:5174

# "open" (anyone may create an account) or "closed" (only existing ones).
KONSPECTER_REGISTRATION=open

# Lifetimes (Go durations: 30m, 720h).
KONSPECTER_SESSION_TTL=720h
KONSPECTER_EMAIL_CODE_TTL=10m
KONSPECTER_PASSWORD_RESET_TTL=30m

# Email: "smtp" sends through the server below; "log" writes messages to the
# log instead (development only: the log then holds sign-in codes).
KONSPECTER_MAIL_TRANSPORT=log
KONSPECTER_SMTP_HOST=
KONSPECTER_SMTP_PORT=587
KONSPECTER_SMTP_USERNAME=
KONSPECTER_SMTP_PASSWORD=
KONSPECTER_SMTP_FROM=Konspecter <noreply@example.com>
# starttls (port 587), tls (port 465) or none (a local relay only).
KONSPECTER_SMTP_TLS=starttls

# Proxies whose X-Forwarded-For names the real client (the reverse proxy and
# the site's server): comma-separated IPs or CIDR prefixes.
KONSPECTER_TRUSTED_PROXIES=127.0.0.1,::1

# Abuse limits: failed sign-ins per 15 minutes, emails per hour.
KONSPECTER_RATE_LOGIN_PER_IP=20
KONSPECTER_RATE_LOGIN_PER_EMAIL=10
KONSPECTER_RATE_EMAIL_PER_ADDRESS=5
KONSPECTER_RATE_EMAIL_PER_IP=20
