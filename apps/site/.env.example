# Konspecter account site settings. Copy to .env (or point KONSPECTER_ENV_FILE
# at another file); variables set in the real environment win over this file.

# The public address of the site and API (one origin behind the proxy). Used
# to check where forms come from and to mark cookies Secure on https. The Go
# server's KONSPECTER_PUBLIC_URL must be the same address.
# Leave empty in development, where the request's own origin is used.
KONSPECTER_PUBLIC_URL=

# The Go API as this server reaches it (server-side calls). The dev server
# also proxies /api there.
KONSPECTER_API_URL=http://localhost:8080

# Download links on the landing page; a platform without a link is hidden.
KONSPECTER_DOWNLOAD_MACOS_URL=
KONSPECTER_DOWNLOAD_WINDOWS_URL=
KONSPECTER_DOWNLOAD_LINUX_URL=
KONSPECTER_DOWNLOAD_ANDROID_URL=
KONSPECTER_DOWNLOAD_WEB_URL=

# Port of the production server (react-router-serve).
PORT=3000
