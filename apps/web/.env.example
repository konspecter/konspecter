# Build-time settings of the web app (and of the desktop and mobile apps,
# which bundle it). Copy to .env.local; Vite reads it when building.

# The sync server the Sync settings suggest when the host names none in
# /config.json (the web image does, ADR-023). Leave empty to have the user
# type one. Konspecter's own: https://konspecter.com
VITE_KONSPECTER_SERVER_URL=
