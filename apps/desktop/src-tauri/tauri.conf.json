{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Konspecter",
  "version": "0.1.0",
  "identifier": "app.konspecter.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @konspecter/web dev",
    "beforeBuildCommand": "pnpm --filter @konspecter/web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Konspecter",
        "width": 1000,
        "height": 760,
        "minWidth": 420,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 22 },
        "devtools": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost https: http: data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https: http:",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Local-first technical notes in Markdown",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
